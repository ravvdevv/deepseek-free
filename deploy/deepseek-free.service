# systemd unit for running deepseek-free as a permanent service on a VPS.
# Install steps: README → "Persistent service on VPS (systemd)".
[Unit]
Description=deepseek-free (OpenAI/Anthropic-compatible proxy for DeepSeek Web)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deepseek-free
Group=deepseek-free
WorkingDirectory=/opt/deepseek-free
Environment=NODE_ENV=production
Environment=NON_INTERACTIVE=1
Environment=HOST=127.0.0.1
Environment=PORT=9655
Environment=DEEPSEEK_AUTH_PATH=/etc/deepseek-free/deepseek-auth.json
Environment=PROXY_API_KEY_FILE=/etc/deepseek-free/proxy-api-key
Environment=REQUIRE_PROXY_API_KEY=1
# Optional overrides (HOST, DEEPSEEK_* settings); later values win.
EnvironmentFile=-/etc/deepseek-free/env
ExecStart=/usr/bin/env node server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=15

# Hardening: the proxy only reads its code and the auth/key files.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=
UMask=0077

[Install]
WantedBy=multi-user.target
